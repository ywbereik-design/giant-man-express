// Prisma schema for Giant Man Express & Delivery
// Hosted Postgres (e.g. Neon) for both local dev and production — see
// DEPLOY.md for how DATABASE_URL is set in each environment.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// StaffUser.role is one of: ADMIN | DISPATCH | ACCOUNTANT
// ADMIN — full system access: settings, drivers, businesses, reports, invoices.
// DISPATCH — can view/assign jobs and monitor drivers, but no financial or
// account-management access (no reports, invoices, driver/business editing).
// ACCOUNTANT — read-only access to billing data: reports, invoices, and a
// read-only driver/business picker for generating them, but no job/driver
// management and no live location or clock-in-photo access.
model StaffUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Bumped on every password change so existing JWTs (which embed the value
  // at sign time) stop validating immediately — otherwise a stolen token
  // would keep working for its full lifetime even after a password reset.
  tokenVersion Int @default(0)
}

model Driver {
  id           String   @id @default(cuid())
  name         String
  employeeCode String   @unique
  pinHash      String
  phone        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Denormalized "last known position", updated on every location ping while
  // clocked in — lets the admin driver list show a live position without
  // querying the full LocationPing history for every driver.
  currentLat        Float?
  currentLng        Float?
  currentLocationAt DateTime?

  // Bumped on every PIN change so existing JWTs (which embed the value at
  // sign time) stop validating immediately — see StaffUser.tokenVersion.
  tokenVersion Int @default(0)

  jobs          Job[]
  timeEntries   TimeEntry[]
  hoursReports  HoursReport[]
  locationPings LocationPing[]
}

model JobType {
  id     String  @id @default(cuid())
  name   String  @unique
  active Boolean @default(true)

  jobs Job[]
}

model Business {
  id           String   @id @default(cuid())
  name         String
  contactName  String?
  contactEmail String?
  // The client's own contact number — used to auto-fill a job's Client
  // Phone field when dispatch picks this business (see /api/jobs and the
  // Jobs screen), same as address auto-fills Pickup Address.
  phone        String?
  address      String?
  billingRate  Float? // flat $ charged per delivered job on this business's invoices, optional
  createdAt    DateTime @default(now())

  jobs     Job[]
  invoices Invoice[]
}

// Status fields are plain Strings rather than a native Postgres enum, purely
// as a modeling choice made early on (kept for consistency, not a DB
// limitation) — validated in application code instead.
// Job.status is one of:
//   ASSIGNED | ACCEPTED | ARRIVED | PICKED_UP | ON_THE_WAY | DELIVERED | CANCELLED | FAILED
// (validated in application code — see src/lib/constants.ts)

model Job {
  id            String    @id @default(cuid())
  title         String
  jobTypeId     String
  jobType       JobType   @relation(fields: [jobTypeId], references: [id])
  driverId      String
  driver        Driver    @relation(fields: [driverId], references: [id])
  businessId    String?
  business      Business? @relation(fields: [businessId], references: [id])
  pickupAddress String?
  // The recipient's phone number, used for the driver's one-touch Call /
  // WhatsApp buttons on their job card. Optional — jobs created before this
  // field existed, or without a reachable contact, simply don't show those
  // buttons.
  clientPhone   String?
  notes         String?
  status        String    @default("ASSIGNED")
  createdAt     DateTime  @default(now())

  // One pickup, any number of delivery stops — see JobStop below.
  dropoffStops JobStop[]

  // One timestamp per stage of the driver-facing progress flow, set as the
  // driver taps through Accept -> Arrived -> Picked Up -> On the Way ->
  // Delivered (see DRIVER_ALLOWED_TRANSITIONS in src/lib/constants.ts).
  acceptedAt  DateTime?
  arrivedAt   DateTime?
  pickedUpAt  DateTime?
  onTheWayAt  DateTime?
  deliveredAt DateTime?
  // Set when a driver marks the job FAILED instead of progressing it —
  // mutually exclusive with deliveredAt (a job reaches exactly one terminal
  // state).
  failedAt    DateTime?

  // Proof-of-pickup / proof-of-delivery photos, captured by the driver at
  // the ARRIVED->PICKED_UP and ON_THE_WAY->DELIVERED transitions (same
  // compressed-JPEG-data-URL pattern as TimeEntry.clockInPhoto). Nullable
  // here even though the API requires one on those transitions going
  // forward — historical/in-flight jobs predate this field.
  pickupPhoto   String?
  deliveryPhoto String?

  // Device GPS at the moment each proof photo was captured, alongside the
  // already-server-timestamped pickedUpAt/deliveredAt above — lets
  // dispatch/admin verify a photo was actually taken at the job site rather
  // than trusting the image alone.
  pickupLat   Float?
  pickupLng   Float?
  deliveryLat Float?
  deliveryLng Float?

  // Required, driver-selected reason when status is set to FAILED (see
  // FAILURE_REASONS in src/lib/constants.ts) — e.g. "No Answer",
  // "Incorrect Address". Null for every other status.
  failureReason String?

  invoiceLineItems InvoiceLineItem[]

  @@index([driverId])
  @@index([businessId])
  @@index([jobTypeId])
  @@index([status])
  // Matches the exact where-clause shape of /api/invoices and
  // /api/reports/hours-by-business (businessId/driverId + status:"DELIVERED"
  // + deliveredAt range) — without these, that billing-period scan falls
  // back to the single-column businessId/driverId index above and then
  // filters status/deliveredAt row-by-row.
  @@index([businessId, status, deliveredAt])
  @@index([driverId, status, deliveredAt])
}

// A single delivery location on a job — a job has exactly one pickup
// (Job.pickupAddress) and any number of these, in route order.
model JobStop {
  id       String @id @default(cuid())
  jobId    String
  job      Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  address  String
  sequence Int    @default(0)

  @@index([jobId, sequence])
}

// A hand-written partial unique index — CREATE UNIQUE INDEX ... WHERE
// "clockOutAt" IS NULL, see migrations/20260727195557_prevent_concurrent_open_shifts —
// enforces "at most one open shift per driver" at the DB level. Not
// expressible as a @@unique here since Prisma's schema DSL has no partial-
// index syntax; `prisma db pull` would show it, `prisma migrate dev` won't
// try to drop it since it's already applied and the schema hasn't diverged.
model TimeEntry {
  id          String    @id @default(cuid())
  driverId    String
  driver      Driver    @relation(fields: [driverId], references: [id])
  clockInAt   DateTime
  clockInLat  Float?
  clockInLng  Float?
  clockOutAt  DateTime?
  clockOutLat Float?
  clockOutLng Float?

  // Selfie captured when the driver taps "Clock In" — a compressed JPEG
  // data URL, shown to admin/dispatch as proof of who's on shift. Treated
  // as expired 12h after clockInAt (see /api/drivers) rather than shown
  // indefinitely for a shift that ran unusually long or was never closed out.
  clockInPhoto String?

  // Cumulative Haversine distance (km) across every location ping received
  // while this shift was open. lastPingLat/Lng is the previous ping's
  // position, kept so each new ping only needs to add one segment rather
  // than replaying the whole route.
  distanceKm  Float  @default(0)
  lastPingLat Float?
  lastPingLng Float?

  locationPings LocationPing[]

  // Covers both "find this driver's current open shift" and "list this driver's shifts"
  @@index([driverId, clockOutAt])
}

// One row per GPS ping received while a driver is clocked in — the route
// history behind the admin live map / "today's mileage" view. Only ever
// written while the parent TimeEntry is open (see POST /api/driver/location).
model LocationPing {
  id          String    @id @default(cuid())
  driverId    String
  driver      Driver    @relation(fields: [driverId], references: [id])
  timeEntryId String
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id])
  lat         Float
  lng         Float
  recordedAt  DateTime  @default(now())

  @@index([timeEntryId, recordedAt])
  @@index([driverId, recordedAt])
}

model HoursReport {
  id              String   @id @default(cuid())
  reportNumber    String   @unique
  driverId        String
  driver          Driver   @relation(fields: [driverId], references: [id])
  periodStart     DateTime
  periodEnd       DateTime
  totalHours      Float
  totalDistanceKm Float    @default(0)
  generatedAt     DateTime @default(now())
  entriesJson     String // snapshot of the TimeEntry rows included, for a stable historical record

  // Backstops the app-level duplicate check in POST /api/reports against a
  // race between two concurrent requests for the same driver+period (e.g. a
  // double-tap "Generate Report") — the second insert fails with P2002
  // instead of both succeeding and double-counting payroll hours.
  @@unique([driverId, periodStart, periodEnd])
  @@index([driverId])
}

// Invoice.status always holds "FINAL" today — every invoice is generated
// complete in one step (see POST /api/invoices), there's no draft/edit flow
// that would ever produce another value. Kept as a plain string rather than
// removed since it's already a stored, API-exposed field.
model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  businessId    String
  business      Business @relation(fields: [businessId], references: [id])
  periodStart   DateTime
  periodEnd     DateTime
  totalAmount   Float
  status        String   @default("FINAL")
  generatedAt   DateTime @default(now())

  lineItems InvoiceLineItem[]

  @@index([businessId])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  jobId       String?
  job         Job?    @relation(fields: [jobId], references: [id])
  description String
  quantity    Float
  rate        Float
  amount      Float

  // A delivered job must never be billed on two different invoices. Postgres
  // treats multiple NULLs as distinct, so line items with no jobId (if any)
  // don't collide — this only backstops the actual "same job twice" case,
  // guarding against two concurrent POST /api/invoices requests both reading
  // the same "un-invoiced" job before either commits.
  @@unique([jobId])
  @@index([invoiceId])
}

// Backs sequential, human-friendly numbering (HR-0001, INV-0001, ...)
model Counter {
  name  String @id
  value Int    @default(0)
}

// Login-attempt throttling, keyed by e.g. "staff:email@x.com" or
// "driver:D001". DB-backed (not in-memory) because the backend runs as
// serverless functions in production — each invocation can land on a
// different, short-lived process, so in-memory state wouldn't reliably
// persist between requests. See src/lib/rateLimit.ts.
model RateLimitAttempt {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime
}
